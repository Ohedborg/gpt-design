{
  "color": {
    "$type": "color",
    "ink": {
      "$value": "#202024"
    },
    "paper": {
      "$value": "#faf9f6"
    },
    "accent": {
      "$value": "#7357d7"
    }
  },
  "space": {
    "$type": "dimension",
    "small": {
      "$value": "8px"
    },
    "medium": {
      "$value": "16px"
    },
    "large": {
      "$value": "32px"
    }
  },
  "radius": {
    "$type": "dimension",
    "card": {
      "$value": "16px"
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "body": {
        "$value": "system-ui, sans-serif"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "bold": {
        "$value": 700
      }
    },
    "size": {
      "$type": "dimension",
      "small": {
        "$value": "0.875rem"
      },
      "body": {
        "$value": "1rem"
      },
      "heading-small": {
        "$value": "1.5rem"
      },
      "heading-medium": {
        "$value": "2rem"
      },
      "heading-large": {
        "$value": "3rem"
      },
      "display": {
        "$value": "4.5rem"
      }
    },
    "line-height": {
      "$type": "number",
      "body": {
        "$value": 1.5
      },
      "heading": {
        "$value": 1.2
      }
    }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": "0 4px 16px rgba(0,0,0,0.08)"
    }
  },
  "size": {
    "container": {
      "$type": "dimension",
      "$value": "1200px"
    }
  },
  "opacity": {
    "disabled": {
      "$type": "number",
      "$value": 0.5
    }
  }
}
